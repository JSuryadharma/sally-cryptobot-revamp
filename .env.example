# robocrypto is DB-backed now - every business setting (watchlist, trading
# parameters, Binance base URL, Telegram, the OpenAI advisor) lives in
# Postgres via src/settings.js, editable at runtime from the Settings page.
# There is no local-file fallback: the app requires a working database
# connection to start, on Vercel or locally.
#
# DATABASE_URL (or POSTGRES_URL) - a standard postgres:// connection string -
# is the ONLY thing that has to live here, plus PORT, which can't live in the
# database (the server has to bind a port before it can query one). Connect a
# Postgres database from your Vercel project's Storage tab (the Neon
# integration has a free tier, unlike the Redis/KV option) and it should
# inject DATABASE_URL automatically; for local dev, point this at any
# Postgres instance (Neon/Supabase/a local Docker container/etc.) - src/pgClient.js
# auto-creates the one table it needs (kv_store) on first use.
DATABASE_URL=

# Requires TLS by default (every managed Postgres host needs it); set this to
# false only for a local/self-hosted instance with no TLS listener.
POSTGRES_SSL=

PORT=3300
