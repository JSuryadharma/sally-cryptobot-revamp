# Copy to deploy/.env on the server and fill in. Never commit the filled-in file.

# The address the app will live at. Its DNS A record must point to this server.
# No domain? Use your server IP with dashes + .sslip.io, e.g. 203-0-113-7.sslip.io
DOMAIN=

# Password for the bundled Postgres. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Same value as the Bearer token in the cron-job.org job.
# Generate with: openssl rand -hex 32  (or reuse the current Vercel value)
ENGINE_TICK_SECRET=

# Optional: keep using an external database (e.g. the current Neon one) instead
# of the bundled Postgres. Leave empty to use the bundled one.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# POSTGRES_SSL=true

# Optional: set to "on" to let the server tick itself every minute instead of
# relying on cron-job.org. Don't run both.
# ENGINE_LOCAL_LOOP=off
