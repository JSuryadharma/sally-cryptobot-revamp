# Copy to deploy/.env on the server and fill in. Never commit the filled-in file.

# The address the app will live at. Its DNS A record must point to this server.
# No domain? Use your server IP with dashes + .sslip.io, e.g. 203-0-113-7.sslip.io
DOMAIN=

# URL path the app is served under: https://DOMAIN/sally/
# Leave it empty (BASE_PATH=) to serve it at the root of the domain.
BASE_PATH=/sally

# Password for the bundled Postgres. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional: keep using an external database (e.g. the current Neon one) instead
# of the bundled Postgres. Leave empty to use the bundled one.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA (schema optional)
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?schema=sallybot&sslmode=require
# POSTGRES_SSL=true

# The server ticks itself every minute (default "on"), and POST /api/engine/tick is
# disabled. Set to "off" to drive it from cron-job.org instead.
# ENGINE_LOCAL_LOOP=on

# ---- Real trading (optional, docs/LIVE-TRADING.md) ----
# paper (default) | binance-testnet | binance-live   (ajaib-testnet | ajaib-live: limit orders only, not recommended)
# BROKER_CRYPTO=paper
# Binance API key: enable Spot trading ONLY, never withdrawals; restrict it to this server's IP.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# Hard cap per real buy in USDT (default 50), and real size = robot's paper size x BROKER_SCALE (default 1).
# BROKER_MAX_ORDER=50
# BROKER_SCALE=1
# Skip a copy when the robot's paper buy is older than this many minutes (default 30).
# BROKER_MAX_ENTRY_DELAY_MIN=30
# IDX stocks: ajaib-manual (Ajaib order tickets as notifications, default) | off
# BROKER_IDX=ajaib-manual
